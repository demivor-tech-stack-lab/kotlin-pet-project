# =====================================================================
# Copy file nay thanh .env roi dien gia tri that:
#     cp .env.example .env
#
# ⚠️ .env DA NAM TRONG .gitignore - TUYET DOI khong commit no len Git.
# =====================================================================

# ---- Database ----
POSTGRES_DB=vehiclerental
POSTGRES_USER=vehiclerental
# Sinh mat khau manh:  openssl rand -base64 32
POSTGRES_PASSWORD=DOI-CHUOI-NAY

# ---- Bao mat ----
# BAT BUOC. Toi thieu 32 ky tu. Sinh bang:  openssl rand -base64 48
# Doi gia tri nay = da dang xuat toan bo nguoi dung (moi access token thanh vo hieu).
JWT_SECRET=DOI-CHUOI-NAY-TOI-THIEU-32-KY-TU-NHE-BAN-OI

# ---- CORS ----
# BAT BUOC o production. Liet ke domain frontend, cach nhau bang dau phay.
# KHONG ke http:// hay https:// o day, chi ten mien.
CORS_ALLOWED_HOSTS=app.example.com,admin.example.com

# ---- Tuy chon (co gia tri mac dinh hop ly) ----
APP_TIMEZONE=Asia/Ho_Chi_Minh
DB_POOL_SIZE=10
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=300
API_MEMORY_LIMIT=768M

# Neu dat, endpoint /metrics se yeu cau header:
#     Authorization: Bearer <gia tri nay>
# Sinh bang:  openssl rand -hex 32
METRICS_TOKEN=
