<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- %X{requestId} in ma dinh danh request vao MOI dong log sinh ra trong request do.
                 Khach bao loi kem ma nay -> grep mot phat la ra toan bo dong doi request. -->
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{28} [%X{requestId:--}] - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Bat dong nay de xem SQL that su Exposed sinh ra - rat dang de hoc -->
    <logger name="Exposed" level="INFO"/>
    <logger name="org.koin" level="INFO"/>
    <logger name="io.netty" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
</configuration>
